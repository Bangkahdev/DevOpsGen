# Dockerfile for Next.js applications.
# Runs `next start`, so production dependencies must be present at runtime.

FROM node:20-alpine AS builder

WORKDIR /app

# Ensure package.json exists so npm install does not fail on an empty project.
RUN if [ ! -f package.json ]; then printf '{"name":"app","version":"1.0.0","private":true}\n' > package.json; fi
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY . .
RUN mkdir -p public
RUN {{.BuildOrDefault}}
RUN npm prune --omit=dev

FROM node:20-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

EXPOSE {{.Port}}

USER 1000:1000

CMD ["sh", "-c", {{printf "%q" .StartOrDefault}}]