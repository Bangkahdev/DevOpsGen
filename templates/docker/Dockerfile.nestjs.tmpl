# Dockerfile for NestJS applications.
# Build compiles to dist/; runtime executes the compiled output.

FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN {{.InstallCmd}}

COPY . .
RUN {{.BuildOrDefault}}

FROM node:20-alpine AS runtime

WORKDIR /app

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist

EXPOSE {{.Port}}

USER 1000:1000

CMD ["sh", "-c", {{printf "%q" .StartOrDefault}}]