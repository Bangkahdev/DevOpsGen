# Dockerfile for Vite applications (static assets).
# Build produces static assets served by a lightweight Node server.

FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY . .
{{if .BuildCmd}}RUN {{.BuildCmd}}{{else}}RUN npm run build{{end}}

FROM node:20-alpine AS runtime

WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

EXPOSE {{.Port}}

USER 1000:1000

CMD ["node", "node_modules/.bin/serve", "-s", "dist", "-l", "{{.Port}}"]