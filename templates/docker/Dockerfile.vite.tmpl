# Dockerfile for Vite applications (static assets).
# Build produces static assets served by a lightweight Node server.

FROM node:20-alpine AS builder

WORKDIR /app

# Ensure package.json exists so npm install does not fail on an empty project.
RUN if [ ! -f package.json ]; then printf '{"name":"app","version":"1.0.0","private":true}\\n' > package.json; fi
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY . .
RUN {{.BuildOrDefault}}

FROM node:20-alpine AS runtime

WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

EXPOSE {{.Port}}

USER 1000:1000

CMD ["sh", "-c", {{printf "%q" .StartOrDefault}}]