# Dockerfile for Python applications.
# Supports FastAPI, Django, Flask, and generic Python apps.
# Uses a virtualenv at /opt/venv on a slim base image so the runtime user
# (1000) can read installed packages without relying on /root/.local.
# Build and startup commands are resolved per SRS 4.2.

FROM python:3.12-slim AS builder

WORKDIR /app

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN python -m venv $VIRTUAL_ENV

COPY requirements*.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

{{if .BuildCmd}}RUN {{.BuildCmd}}{{end}}

FROM python:3.12-slim AS runtime

WORKDIR /app

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

EXPOSE {{.Port}}

USER 1000:1000

{{if .StartCmd}}CMD ["sh", "-c", {{printf "%q" .StartCmd}}]{{else}}CMD ["python", "app.py"]{{end}}
