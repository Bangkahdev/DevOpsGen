# .dockerignore generated by DevOpsGen.
# Keeps the build context minimal and secrets out of the image:
# local state, tool caches, and env files never reach `COPY . .`.
.git
.github
.devopsgen
*.devopsgen.bak
**/.env
**/.env.*
node_modules
{{- if eq .Stack "nodejs"}}
dist
coverage
.nyc_output
.next
{{- end}}
