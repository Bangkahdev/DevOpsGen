# Dockerfile for Node.js express applications.
# Build and startup commands are written into this file for the user to run;
# DevOpsGen does not execute them. The runtime stage copies the whole built
# application so it works regardless of project layout.

FROM node:20-alpine AS builder

WORKDIR /app

# Ensure package.json exists so npm install does not fail on an empty project.
RUN if [ ! -f package.json ]; then echo '{"name":"app","version":"1.0.0","private":true}' > package.json; fi
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY . .
{{- if .BuildOrDefault}}
RUN {{.BuildOrDefault}}
{{- end}}
RUN npm prune --omit=dev

FROM node:20-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app ./

EXPOSE {{.Port}}

USER 1000:1000

CMD ["sh", "-c", {{printf "%q" .StartOrDefault}}]