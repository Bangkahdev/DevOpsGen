# GitHub Actions workflow generated by DevOpsGen.
# Deterministic: no runtime env values are injected.
# Publishes the commit SHA tag (immutable) and the configured alias.

name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

jobs:
  build-and-publish:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write

    steps:
      - name: Checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262

      - name: Set up Go
        if: ${{ .Stack == 'go' }}
        uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff
        with:
          go-version: '1.22'

      - name: Set up Node.js
        if: ${{ .Stack == 'nodejs' }}
        uses: actions/setup-node@60edb5dd5467a26f8c3f7c8b8a4f5e0c7d6b3a9e
        with:
          node-version: '20'

      - name: Install dependencies
        if: ${{ .Stack == 'nodejs' }}
        run: npm ci

# [[- if .TestCmd ]]
      - name: Test
        run: [[.TestCmd]]
# [[- else ]]
      - name: Test stage skipped
        run: echo "Test stage is not configured for this project. No test command was provided, so tests are intentionally not run."
# [[- end ]]

      - name: Build image
        run: |
          docker build -t [[.ImageRef]]:[[.Tag]] -t [[.ImageRef]]:${{ github.sha }} -f Dockerfile .

      - name: Login to Docker Hub
        if: ${{ .Registry == 'dockerhub' }}
        uses: docker/login-action@74a5d142397b44f367a81161e53450f414642c6c
        with:
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      - name: Login to GHCR
        if: ${{ .Registry == 'ghcr' }}
        uses: docker/login-action@74a5d142397b44f367a81161e53450f414642c6c
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Push image
        run: |
          docker push [[.ImageRef]]:[[.Tag]]
          docker push [[.ImageRef]]:${{ github.sha }}