# Kubernetes Deployment generated by DevOpsGen.
# Baseline resource values are not optimal for every workload —
# adjust requests/limits based on actual load.

apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{.Name}}
  labels:
    app: {{.Name}}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{.Name}}
  template:
    metadata:
      labels:
        app: {{.Name}}
    spec:
      containers:
        - name: {{.Name}}
          image: {{.ImageRef}}:{{.Tag}}
          ports:
            - containerPort: {{.Port}}
          resources:
            requests:
              cpu: "100m"
              memory: "128Mi"
            limits:
              cpu: "500m"
              memory: "256Mi"
{{- if .HealthPath}}
          livenessProbe:
            httpGet:
              path: {{.HealthPath}}
              port: {{.Port}}
            initialDelaySeconds: 30
          readinessProbe:
            httpGet:
              path: {{.HealthPath}}
              port: {{.Port}}
            initialDelaySeconds: 10
{{- end}}
