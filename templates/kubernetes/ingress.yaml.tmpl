# Kubernetes Ingress generated by DevOpsGen.
# Membutuhkan Ingress Controller dan konfigurasi cluster yang sesuai.
# Keberadaan manifest ini saja tidak menjamin akses eksternal otomatis.

apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{.Name}}
spec:
  rules:
    - host: {{.IngressHost}}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{.Name}}
                port:
                  number: {{.Port}}
